# ============================================
# AdvisorDesk Test Framework - Environment
# ============================================

# Application under test
BASE_URL=http://localhost:8765/demo.html
START_SERVER=true

# Test environment
TEST_ENV=staging
LOG_LEVEL=info
HEADLESS=true

# Public APIs (free-tier / demo endpoints)
JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com
REQRES_URL=https://reqres.in/api
COINGECKO_URL=https://api.coingecko.com/api/v3
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5
EXCHANGERATE_URL=https://api.exchangerate-api.com/v4/latest
RANDOMUSER_URL=https://randomuser.me/api
HTTPBIN_URL=https://httpbin.org
POKEAPI_URL=https://pokeapi.co/api/v2
SWAPI_URL=https://swapi.dev/api
NASA_URL=https://api.nasa.gov
GITHUB_URL=https://api.github.com
CATFACTS_URL=https://catfact.ninja
DOGCEO_URL=https://dog.ceo/api
COUNTRY_URL=https://restcountries.com/v3.1

# Database connection
#   DB_TYPE=sqlite  → uses ./utils/db/advisordesk.db (no setup, default)
#   DB_TYPE=postgres → uses POSTGRES_* (set via docker compose up -d postgres)
DB_PATH=./utils/db/advisordesk.db
DB_TYPE=sqlite

# Postgres (only used when DB_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=advisordesk_test
POSTGRES_USER=advisordesk
POSTGRES_PASSWORD=advisordesk

# MySQL (used by docker compose, optional)
MYSQL_DB=advisordesk_test
MYSQL_USER=advisordesk
MYSQL_PASSWORD=advisordesk
MYSQL_ROOT_PASSWORD=rootpw

# Reporting
REPORT_TITLE=AdvisorDesk Test Report