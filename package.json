{
  "name": "advisordesk-playwright-typescript",
  "version": "1.0.0",
  "description": "Comprehensive Playwright + TypeScript test framework for AdvisorDesk demo with POM, API, and Database testing",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:db": "playwright test --project=db",
    "test:db:pg": "playwright test --project=db-postgres",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:list": "playwright test --list",
    "codegen": "playwright codegen http://localhost:8765/demo.html",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "db:seed": "ts-node utils/db/seed.ts",
    "db:reset": "ts-node utils/db/reset.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U advisordesk -d advisordesk_test",
    "test:api:smoke": "playwright test --project=api --grep @smoke",
    "test:api:list": "playwright test --project=api --list"
  },
  "keywords": [
    "playwright",
    "typescript",
    "POM",
    "fintech",
    "advisordesk",
    "API-testing",
    "database-testing"
  ],
  "author": "QA Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "better-sqlite3": "^11.3.0",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "faker": "^5.5.3",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  }
}
